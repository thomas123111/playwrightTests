# URL des E-Bike-Versicherungsrechners
RECHNER_URL=https://ebikeversicherungen.net/vergleichsrechner/

# Optional: Alternative Rechner-URL (z.B. Staging)
# RECHNER_URL=https://fahrsicherung.de/vergleichsrechner-voll

# Optional: Credentials für geschützte Staging-Umgebungen
# BASIC_AUTH_USER=
